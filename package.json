{
  "name": "forcer",
  "version": "0.1.0",
  "description": "Figma plugin that binds variables to fields regardless of their scopes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n code,ui \"npm run watch:code\" \"npm run watch:ui\"",
    "build": "npm run build:code && npm run build:ui",
    "build:code": "vite build -c vite.config.code.ts",
    "build:ui": "vite build -c vite.config.ui.ts",
    "watch:code": "vite build -c vite.config.code.ts --watch",
    "watch:ui": "vite build -c vite.config.ui.ts --watch",
    "check": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json"
  },
  "author": "nick",
  "license": "",
  "devDependencies": {
    "@figma/plugin-typings": "^1.142.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "concurrently": "^9.2.1",
    "svelte": "^5.40.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
